# Never commit the real API key.
ELEVENLABS_API_KEY=

# Quality-first model for Mandarin sentence drills.
ELEVENLABS_MODEL_ID=eleven_v4

# Select a Mandarin-native voice and place its ID here.
ELEVENLABS_VOICE_ID=

ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE_CODE=zh

# auto uses macOS system curl (and its Keychain trust) or urllib elsewhere.
ELEVENLABS_HTTP_TRANSPORT=auto

# Optional. Omit this to use the current Codex CLI default model.
CODEX_MODEL=
