# Never commit the real API key.
ELEVENLABS_API_KEY=

# Eleven v4 is the initial quality-first candidate. We will compare it with
# multilingual_v2 before generating the complete deck.
ELEVENLABS_MODEL_ID=eleven_v4

# Set this after selecting a Mandarin-native voice in the preview step.
ELEVENLABS_VOICE_ID=

# MP3 is broadly supported by browsers and sufficient for sentence drills.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

